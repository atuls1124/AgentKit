{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaperIntelligenceOutput",
  "type": "object",
  "required": ["domain", "papers"],
  "properties": {
    "domain": {
      "type": "object",
      "required": ["domain", "focusAreas"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "subDomain": { "type": "string" },
        "focusAreas": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "papers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["paperId", "title", "authors", "venue", "keywords", "problem", "methodology", "dataset", "evaluation", "contributions", "limitations", "summary"],
        "properties": {
          "paperId": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "authors": { "type": "array", "items": { "type": "string" } },
          "venue": {
            "type": "object",
            "required": ["name", "year", "type"],
            "properties": {
              "name": { "type": "string" },
              "year": { "type": "integer" },
              "type": { "enum": ["conference", "journal", "preprint", "workshop", "other"] }
            }
          },
          "doi": { "type": "string" },
          "sourceUrl": { "type": "string" },
          "keywords": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "problem": { "type": "string", "minLength": 1 },
          "methodology": { "type": "string", "minLength": 1 },
          "dataset": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "usage": { "enum": ["training", "evaluation", "both"] }
              }
            }
          },
          "evaluation": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "value": { "type": ["number", "string"] },
                "unit": { "type": "string" }
              }
            }
          },
          "contributions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "limitations": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "summary": { "type": "string", "minLength": 50 }
        }
      }
    }
  }
}
