{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GapAnalysis",
  "type": "object",
  "required": ["gaps"],
  "properties": {
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "description", "confidence", "supportingPaperCount", "evidence", "reasoning"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "enum": ["Methodology", "Dataset", "Evaluation", "Deployment", "Explainability", "Scalability", "Clinical", "Ethical"]
          },
          "description": { "type": "string", "minLength": 1 },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "supportingPaperCount": {
            "type": "integer",
            "minimum": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["paperId", "paperTitle", "reason"],
              "properties": {
                "paperId": { "type": "string" },
                "paperTitle": { "type": "string" },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          },
          "reasoning": { "type": "string", "minLength": 80 }
        }
      }
    }
  }
}
