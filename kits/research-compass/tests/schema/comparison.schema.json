{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ComparisonResult",
  "type": "object",
  "required": ["summary", "dimensions", "agreements", "contradictions", "keyInsights"],
  "properties": {
    "summary": { "type": "string", "minLength": 100 },
    "dimensions": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["name", "values"],
        "properties": {
          "name": { "enum": ["problem", "methodology", "dataset", "evaluation", "results", "contributions"] },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["paperId", "value"],
              "properties": {
                "paperId": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          },
          "insight": { "type": "string" }
        }
      }
    },
    "agreements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "contradictions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "keyInsights": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
